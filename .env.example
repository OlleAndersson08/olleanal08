# Kopiera den här filen till ".env" och fyll i det du har.
# Allt är frivilligt – appen funkar utan, men vissa funktioner kräver en nyckel.

# Permanent molndatabas (Postgres). Klistra in länken från Neon eller Vercel Postgres.
# Lämnas den tom används en lokal databas automatiskt (bra för test).
DATABASE_URL=

# AI-coachen. API-nyckel från platform.claude.com. Saknas den svarar coachen
# med ett reservmeddelande istället för riktig AI.
ANTHROPIC_API_KEY=

# Videouppladdning. Sätts automatiskt när du skapar en Blob-store i Vercel
# (Storage → Create → Blob). Saknas den kan företag klistra in en videolänk istället.
BLOB_READ_WRITE_TOKEN=

# ResellPilot (/resellpilot) återanvänder samma tre nycklar ovan: DATABASE_URL
# för sina egna rp_*-tabeller, ANTHROPIC_API_KEY för bildanalys/prisresearch/
# sourcing, och BLOB_READ_WRITE_TOKEN för plaggbilder. Se RESELLPILOT.md.
